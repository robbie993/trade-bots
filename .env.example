# Copy to .env and source it. Nothing here is required to run Phase 1 on
# SQLite with the fixture scout — every value below has a safe default.

# --- storage -------------------------------------------------------------
# Spec names PostgreSQL as the source of truth. SQLite is the zero-setup
# default so the loop and the tests run with no server.
# DATABASE_URL=postgresql://mvv:mvv@localhost:5432/mvv
DATABASE_URL=sqlite:///./data/mvv.db

# --- money (spec section 7) ---------------------------------------------
MVV_INITIAL_BUDGET=1000.00
MVV_EMERGENCY_BUFFER=150.00
MVV_PROCESSOR_FEE_PCT=2.9
MVV_PROCESSOR_FEE_FIXED=0.30
MVV_PROCESSOR_HOLD_PCT=7.5
MVV_PROCESSOR_HOLD_DAYS=90
MVV_SETTLEMENT_DAYS=7

# --- hard boundaries (spec section 6) -----------------------------------
# Daily ad spend above this needs its own scale-up approval.
MVV_SCALE_APPROVAL_THRESHOLD=50.00
# Products from any other platform are refused and escalated.
MVV_APPROVED_PLATFORMS=aliexpress,temu
# true = the loop blocks on an undecided kill request (spec 11.2's skeleton).
# false = it pauses ads, files the request and keeps monitoring everything else.
MVV_BLOCK_ON_APPROVAL=false

# --- discovery -----------------------------------------------------------
MVV_MIN_MARGIN_PCT=5.0
MVV_TARGET_MARKUP=3.0
MVV_ASSUMED_CAC=10.00
MVV_MAX_NEW_EXPERIMENTS_PER_TICK=5

# --- stop condition (spec section 9) ------------------------------------
MVV_KILL_ALL_AFTER_EXPERIMENTS=20
MVV_SCALE_MIN_CM_PCT=20.0

# --- scout ---------------------------------------------------------------
# manual | none | fixture | aliexpress | temu (comma-separated).
#
#   manual   no automated discovery. Enter real products yourself with
#            `python -m src.main experiment add ...`. This is the setting for
#            a real run without API credentials.
#   fixture  demo only. A real run left on 'fixture' keeps creating sample
#            products every tick and spends the 20-experiment stop condition
#            on fake data.
#   aliexpress / temu  need credentials and an implemented fetch_raw();
#            both currently raise SourceNotConfigured.
MVV_SCOUT_SOURCE=fixture
MVV_SCOUT_FIXTURE=./data/products.sample.json
# MVV_DSERS_API_KEY=
# MVV_DSERS_API_SECRET=
# MVV_TEMU_APP_KEY=
# MVV_TEMU_APP_SECRET=
# MVV_TEMU_ACCESS_TOKEN=

# --- notifications -------------------------------------------------------
# Console and a local log file are always on. These add channels.
# MVV_OPERATOR_EMAIL=you@example.com
# MVV_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# MVV_SMTP_HOST=smtp.example.com
# MVV_SMTP_PORT=587
# MVV_SMTP_USER=
# MVV_SMTP_PASSWORD=
# MVV_SMTP_FROM=
MVV_NOTIFICATION_LOG=./data/notifications.log

# --- loop ----------------------------------------------------------------
MVV_TICK_INTERVAL_S=3600

# --- the File Court ------------------------------------------------------
# CodeTribunal is a Hugging Face repo, not a GitHub one:
#   git clone https://huggingface.co/spaces/amine-yagoub/CodeTribunal
MVV_CODETRIBUNAL_PATH=./CodeTribunal
MVV_UPLOADS_DIR=./uploads
MVV_PROCESSED_DIR=./processed
MVV_COURT_LOG=./logs/village.log
MVV_COURT_EXTENSIONS=.zip,.py,.js,.md
MVV_COURT_INTERVAL_S=60
MVV_COURT_TIMEOUT_S=600
# Escalation and verdict bands (see VILLAGE.md).
MVV_COURT_TRIBUNAL_ABOVE=30
MVV_COURT_PANEL_ABOVE=50
MVV_COURT_MIXED_ABOVE=40
MVV_COURT_GUILTY_ABOVE=70
# Yama: npm install -g @juspay/yama
MVV_COURT_YAMA=false
# Autodetected from the clone layout; set only to force a root-level script.
# MVV_CODETRIBUNAL_ENTRYPOINT=
# Extra flags only (--parallel, --evidence-only). --path and --output are
# always supplied by the adapter.
MVV_CODETRIBUNAL_ARGS=

# =========================================================================
# The Trading Edition (src/trading) — see TRADING.md
#
# Every value below is a default; the ecosystem runs with none of them set.
# The two that decide whether real money can move are TRADE_VENUE and
# TRADE_APPROVE_INCREASES. Leave both as they are unless you mean it.
# =========================================================================

# Firms. `trade init` reads this file; it never re-funds an existing firm.
TRADE_FIRMS_CONFIG=./config/firm_config.yaml
TRADE_AUDIT_VAULT=./vault
TRADE_VENDOR_DIR=./vendor
TRADE_TICK_INTERVAL_S=3600

# Market data. synthetic = a seeded random walk: no keys, no network, and
# identical on every machine. csv reads data/market/<SYMBOL>.csv.
TRADE_DATA_SOURCE=synthetic
TRADE_DATA_SEED=20260808
TRADE_HISTORY_DAYS=180
TRADE_DATA_DIR=./data/market

# Execution. `paper` is the ONLY venue that trades without a human. Any other
# value (alpaca, binance, webull) refuses to send an order until a live_trading
# approval exists for that specific venue:
#   python -m src.main trade live-request --venue alpaca
TRADE_VENUE=paper
TRADE_SLIPPAGE_BPS=5
TRADE_FEE_BPS=2

# Per-firm limits.
TRADE_FIRM_ALLOCATION=100000.00
TRADE_RISK_LIMIT=0.02
TRADE_MAX_POSITION_PCT=0.25
TRADE_MAX_POSITIONS=8
TRADE_CASH_FLOOR_PCT=0.05
TRADE_MIN_CONFIDENCE=55.0

# Per-firm kill switch. The first three fire immediately; the last two wait
# for TRADE_MIN_TRADES, because below that they are noise.
TRADE_MAX_DRAWDOWN_PCT=20.0
TRADE_MAX_SINGLE_LOSS_PCT=10.0
TRADE_MAX_CONSECUTIVE_LOSSES=5
TRADE_MIN_TRADES=20
TRADE_MIN_WIN_RATE_PCT=30.0
TRADE_MIN_SHARPE=0.5

# The brokerage. TRADE_APPROVE_INCREASES=1 is the asymmetry: capital may be
# cut automatically and may never be added without a human.
TRADE_APPROVE_INCREASES=1
TRADE_GOOD_SCORE=60.0
TRADE_POOR_SCORE=40.0
TRADE_ALLOCATION_INCREASE=1.10
TRADE_ALLOCATION_DECREASE=0.90
TRADE_MAX_ALLOCATION_MULTIPLE=3.0
TRADE_MIN_ALLOCATION=1000.00
TRADE_TOTAL_CAPITAL=250000.00
TRADE_RECONCILE_TOLERANCE=0.05
TRADE_ECOSYSTEM_MAX_DRAWDOWN_PCT=25.0

# The brain. Same seed + same data = same survivors, on any machine.
TRADE_EVO_SEED=20260808
TRADE_EVO_POPULATION=8
TRADE_EVO_MUTATION_RATE=0.25
TRADE_EVO_PROMOTE=1
TRADE_MEMORY_RECALL=20

# The heart. Set TRADE_ETHICS_STRICT=1 to turn every warning into a block.
TRADE_ETHICS_STRICT=0
TRADE_ETHICS_CONCENTRATION_PCT=40.0
TRADE_MAX_ROUND_TRIPS=4
# TRADE_RESTRICTED_SYMBOLS=TSLA,GME
# Whole categories you will not hold. Enforced only for symbols YOU have
# classified in config/restricted_assets.yaml — this system ships no view of
# what any company does, and an unclassified symbol is recorded as
# unclassified rather than as clean.
# TRADE_RESTRICTED_CATEGORIES=weapons,sanctioned
TRADE_RESTRICTIONS_FILE=./config/restricted_assets.yaml

# The gateway. Off by default — it only ever writes narration, never a
# decision, so nothing stops when it is unreachable.
TRADE_GATEWAY_ENABLED=0
TRADE_GATEWAY_URL=http://localhost:20128/v1
TRADE_GATEWAY_MODEL=claude-sonnet-5
# TRADE_GATEWAY_KEY=

# Live venue credentials. Read from the environment only, never stored in the
# ledger or written to the audit vault. Having them set grants nothing.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# --- Autonomy -------------------------------------------------------------
# `human` (the default) holds every gated decision for you. `council` lets the
# village rule on its own pending decisions from the ledger — it grants,
# refuses, or defers, and a deferred decision still waits for you.
#
# The council has no panel for live trading and never will: an order sent to a
# real broker leaves this system and cannot be taken back. See TRADING.md.
TRADE_AUTONOMY=human
# How near a decision has to be before the council declines to call it.
TRADE_COUNCIL_MARGIN=20
