# Copy to .env and source it. Nothing here is required to run Phase 1 on
# SQLite with the fixture scout — every value below has a safe default.

# --- storage -------------------------------------------------------------
# Spec names PostgreSQL as the source of truth. SQLite is the zero-setup
# default so the loop and the tests run with no server.
# DATABASE_URL=postgresql://mvv:mvv@localhost:5432/mvv
DATABASE_URL=sqlite:///./data/mvv.db

# --- money (spec section 7) ---------------------------------------------
MVV_INITIAL_BUDGET=1000.00
MVV_EMERGENCY_BUFFER=150.00
MVV_PROCESSOR_FEE_PCT=2.9
MVV_PROCESSOR_FEE_FIXED=0.30
MVV_PROCESSOR_HOLD_PCT=7.5
MVV_PROCESSOR_HOLD_DAYS=90
MVV_SETTLEMENT_DAYS=7

# --- hard boundaries (spec section 6) -----------------------------------
# Daily ad spend above this needs its own scale-up approval.
MVV_SCALE_APPROVAL_THRESHOLD=50.00
# Products from any other platform are refused and escalated.
MVV_APPROVED_PLATFORMS=aliexpress,temu
# true = the loop blocks on an undecided kill request (spec 11.2's skeleton).
# false = it pauses ads, files the request and keeps monitoring everything else.
MVV_BLOCK_ON_APPROVAL=false

# --- discovery -----------------------------------------------------------
MVV_MIN_MARGIN_PCT=5.0
MVV_TARGET_MARKUP=3.0
MVV_ASSUMED_CAC=10.00
MVV_MAX_NEW_EXPERIMENTS_PER_TICK=5

# --- stop condition (spec section 9) ------------------------------------
MVV_KILL_ALL_AFTER_EXPERIMENTS=20
MVV_SCALE_MIN_CM_PCT=20.0

# --- scout ---------------------------------------------------------------
# fixture | aliexpress | temu (comma-separated). The platform adapters need
# credentials and an implemented fetch_raw(); see mvv/scout/aliexpress.py.
MVV_SCOUT_SOURCE=fixture
MVV_SCOUT_FIXTURE=./data/products.sample.json
# MVV_DSERS_API_KEY=
# MVV_DSERS_API_SECRET=
# MVV_TEMU_APP_KEY=
# MVV_TEMU_APP_SECRET=
# MVV_TEMU_ACCESS_TOKEN=

# --- notifications -------------------------------------------------------
# Console and a local log file are always on. These add channels.
# MVV_OPERATOR_EMAIL=you@example.com
# MVV_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# MVV_SMTP_HOST=smtp.example.com
# MVV_SMTP_PORT=587
# MVV_SMTP_USER=
# MVV_SMTP_PASSWORD=
# MVV_SMTP_FROM=
MVV_NOTIFICATION_LOG=./data/notifications.log

# --- loop ----------------------------------------------------------------
MVV_TICK_INTERVAL_S=3600
